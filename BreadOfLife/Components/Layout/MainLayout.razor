@inherits LayoutComponentBase
@using BreadOfLife.Services
@inject NavigationManager NavigationManager
@inject HttpClient HttpClient
@inject AuthService AuthService

<div class="main-layout">
    <header class="top-bar">
        <h1>Bread of Life</h1>
        <a class="logo" href="">
            @* <img src="img/logo.svg" /> *@
        </a>

        @if (!AuthService.IsLoggedIn)
        {
            <NavLink href="baker/login" class="nav-tab" Match="NavLinkMatch.All">
                <div>Login</div>
            </NavLink>

            <NavLink href="baker/register" class="nav-tab">
                <div>Sign Up</div>
            </NavLink>
        }
        <NavLink href="checkout" class="nav-tab">
            <div>Checkout</div>
        </NavLink>

        @if (AuthService.IsLoggedIn)
        {
            <NavLink href="addproduct" class="nav-tab">
                <div>Add Product</div>
            </NavLink>
        }
    </header>


    <div class="content">
        @Body
    </div>

    <footer>
        &copy; Bread of Life @DateTime.UtcNow.Year | Kyle Bowser | Antony | CSE 325 Final Project
    </footer>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
