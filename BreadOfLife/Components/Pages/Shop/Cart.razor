@page "/cart"
@using BreadOfLife.Services
@using BreadOfLife.Models
@inject CartService CartService
@inject NavigationManager NavManager
@implements IDisposable

<div class="container">
    <h2>Your Shopping Cart</h2>

    @if (!CartService.Items.Any())
    {
        <p>Your cart is empty.</p>
        
        <!-- Dummy button to simulate adding an item for testing -->
        <button class="btn" @onclick="AddDummyItem">Add Sample Cookies ($15.00)</button>
    }
    else
    {
        <ul>
            @foreach (var item in CartService.Items)
            {
                <li>@item.Quantity x @item.Name - $@(item.Price * item.Quantity)</li>
            }
        </ul>
        <h3>Total: $@CartService.GetTotal()</h3>
        <button class="btn" @onclick='() => NavManager.NavigateTo("/checkout")'>Proceed to Checkout</button>
    }
</div>

@code {
    protected override void OnInitialized()
    {
        CartService.OnCartChanged += StateHasChanged;
    }

    public void Dispose()
    {
        CartService.OnCartChanged -= StateHasChanged;
    }

    private void AddDummyItem()
    {
        CartService.AddToCart(new CartItem { Name = "Chocolate Chip Cookies (Dozen)", Price = 15.00m, Quantity = 1 });
    }
}