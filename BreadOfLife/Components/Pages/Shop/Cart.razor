@page "/cart"
@rendermode InteractiveServer
@using BreadOfLife.Services
@using BreadOfLife.Models
@inject CartService CartService
@inject NavigationManager NavManager
@implements IDisposable

<div class="cart-wrapper">
    <div class="cart-card">
        <h2>Your Shopping Cart</h2>

        @if (!CartService.Items.Any())
        {
            <div class="empty-cart">
                <p>Your cart is empty. Looks like you need some fresh baked goods!</p>
                <a href="/" class="btn-continue-shopping">Browse Products</a>
            </div>
        }
        else
        {
            <div class="cart-table-container">
                <table class="cart-table">
                    <thead>
                        <tr>
                            <th>Item</th>
                            <th>Price</th>
                            <th>Quantity</th>
                            <th>Subtotal</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in CartService.Items)
                        {
                            <tr>
                                <td class="item-name">@item.Name</td>
                                <td>$@item.Price.ToString("0.00")</td>
                                <td>
                                    <div class="quantity-controls">
                                        <button @onclick="() => UpdateQuantity(item.Id, item.Quantity - 1)">-</button>
                                        <span>@item.Quantity</span>
                                        <button @onclick="() => UpdateQuantity(item.Id, item.Quantity + 1)">+</button>
                                    </div>
                                </td>
                                <td class="item-subtotal">$@((item.Price * item.Quantity).ToString("0.00"))</td>
                                <td>
                                    <button class="btn-remove" title="Remove Item"
                                            @onclick="() => RemoveItem(item.Id)">🗑️</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            
            <div class="cart-summary">
                <h3>Total: $@CartService.GetTotal().ToString("0.00")</h3>
                <button class="btn-checkout" @onclick='() => NavManager.NavigateTo("/checkout")'>Proceed to
                    Checkout</button>
                </div>
            }
        </div>
    </div>

@code {
    protected override void OnInitialized()
    {
        CartService.OnCartChanged += StateHasChanged;
    }

    public void Dispose()
    {
        CartService.OnCartChanged -= StateHasChanged;
    }

    private void RemoveItem(string id)
    {
        CartService.RemoveFromCart(id);
    }

    private void UpdateQuantity(string id, int quantity)
    {
        CartService.UpdateQuantity(id, quantity);
    }
}