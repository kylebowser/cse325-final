@page "/addproduct"
@using BreadOfLife.Components.Shared
@using BreadOfLife.Components.Model
@inject HttpClient HttpClient
@inject NavigationManager NavigationManager

<div class="form-wrapper">
    <div class="form-card">
        <h2>Add New Product</h2>
        <p class="form-subtitle">Enter the details for your new fresh baked item.</p>

        @if (isError)
        {
            <div class="error-message">Please enter all required product details.</div>
        }

        <EditForm Model="product" OnValidSubmit="SaveProduct">
            <DataAnnotationsValidator />
            
            <div class="form-inputs">
                <!-- This component holds actual input fields -->
                <ProductAdder Product="product" />
            </div>

            <button class="btn-submit" type="Submit" disabled=@isError>Add Product</button>
        </EditForm>
    </div>
</div>

@code {
    private Product product = new();
    bool isError = false;

    protected void ShowError()
    {
        isError = true;
    }

    async Task SaveProduct()
    {
        var response = await HttpClient.PostAsJsonAsync(NavigationManager.BaseUri + "api/products", product);
        var newProductId = await response.Content.ReadAsStringAsync();
        // Assuming API returns the literal ID. We might need to adjust based on how MongoDB returns the ID.
        NavigationManager.NavigateTo($"/product/{newProductId}");
    }
}